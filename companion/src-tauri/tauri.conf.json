{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Persona",
  "version": "0.2.0",
  "identifier": "com.orizon.persona.companion",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ..",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Persona • Hoje",
        "width": 360,
        "height": 560,
        "minWidth": 300,
        "minHeight": 110,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "persona",
        "title": "Orizon Persona",
        "url": "persona/index.html",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  }
}
